/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import re
s=Path('notes/ihara-dirac/astra-proofs.md').read_text()
assert s.count('\\\\[')==s.count('\\\\]')
expected=[f'T{k}({chr(97+i)})' for k,n in [(1,4),(2,5),(3,6),(4,3)] for i in range(n)]
found=re.findall(r'"'^### (T'"\\d\\([a-z]\\)) -- (PROVED(?:-CORRECTED)?)',s,re.M)
assert [x for x,_ in found]==expected
for section in re.split(r'"'^### '"',s,flags=re.M)[1:]:
    head=section.splitlines()[0]
    steps=[int(x) for x in re.findall(r'"'^'"\\*\\*<1>(\\d+)\\.',section,re.M)]
    assert steps==list(range(1,len(steps)+1)),(head,steps)
in_display=False
for n,line in enumerate(s.splitlines(),1):
    if line.strip()==r'\\[':in_display=True;continue
    if line.strip()==r'\\]':in_display=False;continue
    if line.startswith('|') and not in_display:
        expect=4 if n<35 else 5
        assert line.count('|')==expect,(n,line)
    assert line.count('"'$'"')%2==0,(n,line)
