    39	/* Minimal eigenpair of the real symmetric E. Up to `iters` inverse-iteration steps on midpoints
    40	 * (one LU reused; stops early when stationary), then Rump's verified enclosure, retried up to 3 times. On success returns 1 with eps and v (length dim(E)) as certified balls
    41	 * (v normalised as Rump returns it); returns 0 if the enclosure could not be certified. */
    42	int zst_eigmin(arb_t eps, arb_ptr v, const arb_mat_t E, slong iters, slong prec);
    43	
    44	/* Number of eigenvalues of the symmetric A strictly below `shift`, by the inertia of the unpivoted
    45	 * LDL^T factorisation of A - shift. Returns -1 if some pivot ball contains zero (inconclusive). */
    46	slong zst_inertia_neg(const arb_mat_t A, const arb_t shift, slong prec);
    47	
    48	/* Certificate of the paper's even-simple hypothesis from a certified even eigenpair (eps, v):
    49	 * with s = 2 * upper(eps), certifies by ball Cholesky that E - s + v v^T/|v|^2 and O - s are positive
    50	 * definite. Then E - s has exactly one negative eigenvalue (interlacing under the rank-one update,
    51	 * and eps - s < 0 along v) and O - s has none: eps is the simple smallest eigenvalue of the whole
    52	 * matrix and its eigenvector is even. Error amplification is linear in the condition number, unlike
    53	 * the unpivoted LDL^T of zst_inertia_neg. Returns 1 if certified, 0 otherwise. */
    54	int zst_certify_even_simple(const arb_mat_t E, const arb_mat_t O, const arb_t eps, arb_srcptr v, slong prec);
    55	
    56	/* The N positive zeros of g(s) = sum_{j=-N}^{N} xi_j/(j - s), xi_{-j} = xi_j, xi[0..N] given as
    57	 * balls with sum_j xi_j = 1 (g is odd, so these are half of its 2N real zeros). Candidates are the
    58	 * square roots of the eigenvalues of the odd block of D'^2 (approximate QR); each is certified by
    59	 * interval Newton. Writes up to `maxroots` certified, pairwise disjoint root balls into `roots`,
    60	 * increasing; returns the count. A return value of N is a certified complete list. *unresolved
    61	 * counts candidates that could not be certified (0 on success). */
    62	slong zst_secular_roots(arb_ptr roots, slong maxroots, slong *unresolved,
    63	                        arb_srcptr xi, slong N, slong prec);
    64	
