    66	 * and the certified root ball if some interval s_approx +- 2^e (e from -prec/3 up to -16) is mapped
    67	 * strictly into itself by the Newton operator, then contracted; 0 otherwise. */
    68	int zst_secular_verify(arb_t root, arb_srcptr xi, slong N, const arb_t s_approx, slong prec);
    69	
    70	/* h_j(s) = g(s) (j - s)(j + 1 - s) for j < N, h_N(s) = g(s)(N - s): value and derivative at the ball s. */
    71	void zst_secular_eval(arb_t val, arb_t der, const arb_t s, arb_srcptr xi, slong N, slong j, slong prec);
    72	
    73	/* gamma[k-1] = Im rho_k for k = 1..K. */
    74	void zst_zeta_zeros(arb_ptr gamma, slong K, slong prec);
