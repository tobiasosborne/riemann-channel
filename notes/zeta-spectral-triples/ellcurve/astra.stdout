   806	\section{The infrared spectral triples}
   807	In this section we shall construct infrared spectral triples naturally associated to the scaling operator in $L^2( [\lambda^{-1},\lambda],d^*u)$ with periodic boundary conditions. The intent is to modify the periodic boundary conditions in order to insert in the kernel of the modified scaling operator the eigenvector which realizes the minimum of the Weil quadratic form in the Hilbert space $L^2( [\lambda^{-1},\lambda],d^*u)$. In order to obtain this perturbation we work at the truncated level and use instead of the evaluation on the boundary of the interval $[\lambda^{-1},\lambda]$ an approximation to this evaluation which is given by the Dirichlet kernel. We then show the existence and uniqueness of the perturbed scaling operator, together with two fundamental facts. The first is that this operator becomes self-adjoint provided one modifies the inner product using the Weil quadratic form. The second point is that one can compute the spectrum of this operator using the Fourier transform of the minimal eigenvector. 
   808	\subsection{Truncation of $QW_\lambda$}
   809	 Let $\lambda>1$, $L=2\log \lambda$, $U_n$ as defined in \eqref{expbasis} and $V_n=\kappa(U_n)$ the orthonormal basis of $L^2( [\lambda^{-1},\lambda],d^*u)$ given in \eqref{vN}.
   810	Let $N\in \N$, we consider the quadratic form $QW_\lambda^N$ obtained by restricting the Weil quadratic form $QW_\lambda$ to the finite dimensional space of test functions spanned by the functions $V_n$ for $\vert n\vert \leq N$.\newline
   811	By \eqref{weilQexp}, the matrix elements of $T=QW_\lambda^N$ in the basis $V_n$ are given by
   812	\begin{equation} \label{formN}
   813		\tau_{n,m}=\int_0^L q(U_n,U_m)(y)\cD(y)
   814	  \qquad i,j\in \{-N,\ldots,N\}	
   815	  \end{equation}
   816	where $\cD$ is the real distribution $\cD=\log_*(\Psi^\sharp)$ on the interval $[0,L]$.
   817	\begin{lem}\label{basicexpli} 
   818	The matrix $\tau_{n,m}$ is a real symmetric matrix of the form
   819	\begin{equation} \label{form}
   820		\tau_{i,i}=a_i,\quad  \forall i, \qquad\  \tau_{i,j}=\frac{b_i-b_j}{i-j}, \quad \forall j\neq i;
   821	  \qquad i,j\in \{-N,\ldots,N\}	
   822	  \end{equation}
   823	where the real scalars $a_i$ fulfill $a_{-j}=a_j$ and $b_{-j}=-b_j$  for all $j\in \{-N,\ldots,N\}$.
   824	\end{lem}
   825	\proof This follows from the computation of the functions $q(U_n,U_m)(y)$ for $y\in [0,L]$ in \eqref{symrealmn} and \eqref{symrealn1}, which gives for $n\neq m$
   826	$$
   827	\tau_{n,m}=\int_0^L \frac{\sin(2\pi m y/L)-\sin(2\pi n y/L)}{\pi (n-m)} \cD(y)\implies $$ $$b_n=-\frac{1}{\pi}\int_0^L \sin(2\pi n y/L)
   828	\cD(y)
   829	$$
   830	and for $n=m$,
   831	$$
   832	\tau_{n,n}=2\int_0^L(1-y/L) \cos(2\pi n y/L)\cD(y)=a_n
   833	$$
   834	\endproof 
   835	\subsection{Properties of truncated matrices}
   836	In this section we let $N$ be a positive integer, $E_N$ be the Hilbert space with orthonormal basis $\{V_n, n\in \{-N,\ldots,N\}\}$ and $T$ a real symmetric matrix of the form \eqref{form}. We recall the basic properties of \cite{CS} for matrices of this form. 
   837	\begin{lem}\label{basics} $(i)$~Let $\gamma$ such that $\gamma(V_j):=V_{-j}$  $\forall j\in \{-N,\ldots,N\}$. One has $\gamma^2=\id$ and $T\gamma=\gamma T$.\newline
   838	$(ii)$~Let $D$ be defined by $D(V_n):=n\,V_{n}$ for all $n\in \{-N,\ldots,N\}$. One has $D\gamma=-\gamma D$ and 
   839	\begin{equation}\label{QD}
   840	D\,	T-T\, D=\vert \beta\rangle\langle \eta\vert -\vert \eta\rangle\langle \beta\vert, \ \ \beta=\sum b_j\,V_j,\ \ \eta=\sum V_j.
   841	\end{equation}	
   842	\end{lem}
   843	\proof $(i)$~One has $q_{-i,-j}=q_{i,j}$ for all $i,j\in \{-N,\ldots,N\}$.\newline
   844	$(ii)$~The diagonal elements of the diagonal matrix $D$ are antisymmetric which gives $D\gamma=-\gamma D$. Let us prove \eqref{QD}. One has 
   845	$$(DT)_{i,j}=i\tau_{i,j}, \ (TD)_{i,j}= j\tau_{i,j}$$ so that $(D\,	T-T\, D)_{i,j}=(b_i-b_j)$ for all $i,j\in \{-N,\ldots,N\}$. Similarly one has 
   846	$$
   847	(\vert \beta\rangle\langle \eta\vert)_{i,j}=\vert \beta\rangle_i\langle \eta\vert_j=b_i, \ \ (\vert \eta\rangle\langle \beta\vert)_{i,j}=\vert \eta\rangle_i\langle \beta\vert_j=b_j
   848	$$
   849	which gives the required equality.\endproof 
   850	\begin{defn}\label{even-simple} A real symmetric matrix $T$ commuting with the $\Z/2$-grading $\gamma$ is {\bf even-simple} if its smallest eigenvalue is simple and the corresponding eigenvector $\xi$ satisfies $\gamma \xi=\xi$.
   851	\end{defn}
   852	We now assume that $T$ is even simple and positive and  let 
   853	$\xi\in \ker\, T$, $\xi\neq 0$. The real symmetric positive  matrix $T$ defines an inner product on $\R^{2N+1}$ and its radical consists of the one dimensional subspace generated by $\xi$. Let us first show that we can normalize $\xi$ by the condition 
   854	\begin{equation}\label{norxi}
   855		\langle \xi\mid \eta\rangle=1
   856	\end{equation}
   857	If $D\xi=0$ then $V_0\in \ker\, T$ fulfills \eqref{norxi}. So we can assume that $D\xi\neq 0$. One has 
   858	 $TD\xi\neq 0$ since $D\xi$ is odd and linearly independent of $\xi$ while $\ker\, T$ is one-dimensional. By \eqref{QD} one has
   859	 $$
   860	 0\neq (D\,	T-T\, D)(\xi)=\vert \beta\rangle\langle \eta\vert\xi\rangle -\vert \eta\rangle\langle \beta\vert\xi\rangle=\vert \beta\rangle\langle \eta\vert\xi\rangle.
   861	 $$ 
   862	 Thus one can normalize $\xi$ so that $\langle \eta\vert\xi\rangle=1$. 
   863	\begin{lem}\label{key} Assume $T\geq 0$ and $\Ker\, T=\C\xi$ where $\gamma \xi=\xi$ and $\langle \xi\mid \eta\rangle=1$. \newline
   864	$(i)$~One has $T\, D\,\xi=-\beta $.\newline
   865	$(ii)$~The operator $D':=D-\vert D\,\xi\rangle\langle \eta\vert$ induces a selfadjoint operator  $D"$ in the Hilbert space associated to the inner product defined by $T$, as quotient by null vectors.	\newline
   866	$(iii)$~One has, denoting by $\xi_j$ the components of $\xi$, 
   867	\begin{equation}
   868	   \Det(D" - s) =   \Det(D - s) \sum_{j=-N}^N (j -s)^{-1} \xi_j.
   869	   \label{eq:detDp}
   870	   \end{equation}
   871	\end{lem}
   872	\proof $(i)$~We apply \eqref{QD} and get, using  $T\xi=0$ and $\langle \beta\vert \xi \rangle=0$ since the two eigenspaces of $\gamma$ are orthogonal,
   873	$$
   874	-T\, D\,\xi=(D\,	T-T\, D)\xi=\vert \beta\rangle\langle \eta\vert \xi\rangle -\vert \eta\rangle\langle \beta\vert \xi \rangle=\beta.
   875	$$
   876	$(ii)$~The inner product defined by $T$ is given by 
   877	$$
   878	\langle f\mid g\rangle_T=\langle T f\mid g\rangle.
   879	$$
   880	We first show that
   881	\begin{equation}\label{herm}
   882		\langle D' f\mid g\rangle_T=\langle f\mid D'g\rangle_T, \  \forall f, g
   883	\end{equation}
   884	  One has, with $R=-\vert D\,\xi\rangle\langle \eta\vert$ 
   885	$$
   886	\langle D' f\mid g\rangle_T=\langle T D'f\mid g\rangle=\langle T Df\mid g\rangle+\langle T Rf\mid g\rangle.
   887	$$
   888	By $(i)$, one has $TR=-\vert TD\xi\rangle \langle \eta\vert=\vert \beta\rangle\langle \eta\vert$.  Thus
   889	$$
   890	T D'=TD+\vert \beta\rangle\langle \eta\vert
   891	$$
   892	Moreover by \eqref{QD}, one has $TD-DT=-\vert \beta\rangle\langle \eta\vert +\vert \eta\rangle\langle \beta\vert$. Thus
   893	$$
   894	T D'=DT+\vert \eta\rangle\langle \beta\vert,
   895	$$ 
   896	$$
   897	\langle D' f\mid g\rangle_T=\langle DTf\mid g\rangle+\langle R'f\mid g\rangle, \ \ R'=\vert \eta\rangle\langle \beta\vert.
   898	$$
   899	 Moreover, using that both $T$ and $D$ are selfadjoint,  
   900	 $$
   901	 \langle f\mid D'g\rangle_T=\langle Tf\mid D g\rangle+\langle Tf\mid R g\rangle=\langle DTf\mid g\rangle+\langle f\mid TR g\rangle
   902	 $$
   903	 and the required equality follows from 
   904	 $$
   905	 TR g=(-TD\xi)\langle \eta\vert g\rangle=\beta \langle \eta\vert g\rangle
   906	 $$
   907	 $$
   908	 \langle f\mid TR g\rangle=\langle f\mid (\vert \beta\rangle\langle \eta\vert g\rangle=\langle f\mid  \beta\rangle\langle \eta\vert g\rangle=\langle R'f\mid g\rangle.
   909	 $$
   910	 The Hilbert space $\cH$ obtained from $E_N$ using the inner product $\langle f\mid g\rangle_T$ is the quotient of $E_N$ by the radical $\Ker\, T=\C\xi$. By construction one has $D'\xi=0$ so that $D'$ induces an operator $D"$ in $\cH$ and $D"$ is selfadjoint by \eqref{herm}. \newline 
   911	 $(iii)$~Let $v_j$ be an orthonormal basis of $\cH$ of eigenvectors for  $D"$ with eigenvalues $\lambda_j$. Let $w_j\in E_N$ be lifts of the $v_j$. One has $D"(v_j)=\lambda_jv_j$ and hence $D'(w_j)=\lambda_jw_j+s_j \xi$ for some  scalars $s_j$. Thus in the basis of $E_N$ formed by $\xi$ and the $w_j$, the matrix of $D'$ is triangular, with $0$ and the $\lambda_j$ on the diagonal. Thus  one gets 
   912	 \begin{equation}\label{det0}
   913	 {\rm Det}(D'-s)=-s\prod (\lambda_j-s)=-s\, {\rm Det}(D"-s)
   914	\end{equation}
   915	 We now compute ${\rm Det}(D'-s)$. We start by writing, in terms of $R =- \langle D \xi \rangle \langle \eta |$:
   916	 $$
   917	D' -s = D+ R-s = (D-s) \left (\id + (D-s)^{-1} R\right)
   918	$$
   919	Consequently 
   920	$$
   921	\Det(D' - s) = \Det(D-s) \Det (\id + (D-s)^{-1} R).
   922	$$
   923	To compute the second determinant we use the identity 
   924	$$
   925	 \Det ({\rm id} + A )=\sum_{k=0}^{\infty} {\rm Tr}\left(\wedge^k A\right)
   926	$$
   927	applied to the rank one operator $A= (D-s)^{-1} R$. The  higher exterior powers $\wedge^k A$ vanish for $k>1$ thus
   928	$$
   929	 \Det ({\rm id} + (D-s)^{-1} R )= 1 - {\rm Tr} \left( | (D-s)^{-1} D \xi \rangle \langle \eta | \right) = -s \langle \eta | (D-s)^{-1} \xi \rangle, 
   930	 $$
   931	 using $(D-s)^{-1} D \xi =\xi+ s (D-s)^{-1}\xi$ and $ \langle \eta | \xi\rangle=1$.
   932	 Hence,
   933	$$
   934	   \Det(D' - s) = -s\, \Det (D-s) \langle \eta | (D-s)^{-1}\xi  \rangle = -s \, \Det (D-s)\, \sum_{j=-N}^N (j -s)^{-1} \xi_j.
   935	   $$
   936	   Thus one obtains \eqref{eq:detDp} using \eqref{det0}.
   937	 \endproof 
   938	
   939	\subsection{The Dirichlet Kernel $\delta_N$ as an approximation of the Dirac Delta}
   940	
   941	The \textbf{Dirichlet kernel}  approximates the Dirac delta function as $N \to \infty$. It is \begin{equation}\label{dirichletdef}
   942	D_N(x) = \sum_{n=-N}^{N} \exp(2 \pi i nx/L), \forall x\in [0, L]
   943	\end{equation}
   944	This can be simplified using the geometric series formula:
   945	\begin{equation}
   946	D_N(x) = \sin\left(\frac{\pi  (2 N+1) x}{L}\right)/\sin\left(\frac{\pi  x}{L}\right)
   947	\end{equation}
   948	for $x \neq 0$ (mod $L$) while $D_N(0)=D_N(L)=2N+1$.
   949	\begin{lem}\label{dirichlet} Let $D=-i\partial_L$ be the selfadjoint operator of differentiation on  $L^2([0,L],dx)$ with periodic boundary conditions. Let $f\in \operatorname{Dom}D$. Then 
   950	\begin{equation}
   951	\lim_{N \to \infty} \frac{1}{L}\int_{0}^{L} D_N(x) f(x) \, dx = f(0)
   952	\end{equation}	
   953	\end{lem}
   954	\proof Let $\hat{f}(n) = \frac{1}{L}\int_{0}^{L} f(x) e^{-2\pi inx/L} \, dx$ be the Fourier coefficients of $f$. 
   955	We have by Parseval's theorem, with  a  constant $c>0$:
   956	\begin{equation}
   957	\sum_{n=-\infty}^{\infty} |n|^2 |\hat{f}(n)|^2 =c\, \|f'\|_{L^2}^2 < \infty
   958	\end{equation}
   959	Since $D_N(x) = \sum_{n=-N}^{N} e^{2\pi inx/L}$, we have:
   960	\begin{equation}
   961	\frac{1}{L}\int_{0}^{L} D_N(x) f(x) \, dx = \sum_{n=-N}^{N} \hat{f}(n)
   962	\end{equation}
   963	So we need to prove that the Fourier series of $f$ converges at $x=0$:
   964	\begin{equation}
   965	\sum_{n=-N}^{N} \hat{f}(n) \to f(0) \quad \text{as } N \to \infty

