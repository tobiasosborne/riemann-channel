   400	\section{The Weil quadratic form $QW$} 
   401	The sesquilinear form $QW$ derives from Weil's formulation of the explicit formula in prime numbers 
   402	theory \cite{Weil}, which we recall below. Let us denote by $\cW(\R^*_+)$ the 
   403	  {\em Weil  class}  of complex valued functions $f$ on $\R^*_+$, by which we mean the functions
   404	having continuous derivative, except at finitely many points where both $f(x)$ and $f'(x)$ may
   405	have at most a discontinuity of the first kind; at such a point the value of $f(x)$ and $f'(x)$ is defined as the average of the right and left limits. In addition, the functions $f \in W(\R^*_+)$ are assumed to satisfy the estimate
   406	$$
   407	f(x)=O(x^\delta), \ \text{for} \ x\to 0+, \ \ f(x)=O(x^{-1-\delta}), \ \text{for} \ x\to +\infty ,
   408	$$  
   409	 for some  $\delta>0$. These functions admit a Mellin transform, denoted 
   410	\begin{equation}\label{mellin}
   411	 \tilde f(s):=\int_0^\infty f(x)x^{s-1}dx .
   412	 \end{equation}
   413	With the additional notation \  $f^\sharp(x):=x^{-1}f(x^{-1})$, the Weil's explicit formula 
   414	takes the form (\cf  \cite{BombieriRH})
   415	 \begin{equation}\label{bombieriexplicit}
   416	 \sum_{\rho}\tilde f(\rho)=\int_0^\infty f(x)dx+\int_0^\infty f^\sharp(x)dx-\sum_v {\mathcal W}_v(f),
   417	 \end{equation}
   418	 where $\rho$ runs over all complex zeros $\rho$ of the Riemann zeta function,  $v$
   419	 runs over all rational places of $\Q$,  the non-archimedean distributions $\mathcal W_p$ are defined as 
   420	 \begin{equation}\label{bombieriexplicit1}
   421	 {\mathcal W}_p(f):=(\log p)\sum_{m=1}^\infty\left(f(p^m)+f^\sharp(p^m)\right),
   422	 \end{equation}
   423	and the archimedean distribution is given by 
   424	 \begin{equation}\label{bombieriexplicit2}
   425	 {\mathcal W}_\R(f):=(\log 4\pi +\gamma)f(1)+\int_{1}^\infty\left(f(x)+f^\sharp(x)-\frac 2x f(1)\right)\frac{dx}{x-x^{-1}} .
   426	 \end{equation}
   427	 It should be noted that the sum in the left hand side of \eqref{bombieriexplicit},
   428	 whose general term is oscillatory, is only conditionally convergent. This issue of lack of absolute convergence is an essential feature of Riemann's formula for the function $\pi(x)$ which is the number of primes less than $x$. In our situation this issue does not appear since we shall only apply the explicit formula to functions which are the convolution (for the group $\R_+^*$) of two square integrable functions with compact support, thus ensuring the absolute convergence of the sum over the zeros.
   429	 
   430	 An equivalent formulation, known as Guinand-Weil formula, uses the Fourier transform 
   431	 \begin{equation} \label{mhat}
   432	 {\widehat F}(s):=\int_{\R^*_+} F(u)u^{-is}d^*u , \qquad  d^*u=\frac{du}{u}
   433	\end{equation}
   434	 in place of the Mellin transform \eqref{mellin}. The passage from one to the other
   435	 is be obtained  by implementing the  automorphism  
   436	 \begin{equation}\label{MF1}
   437	f\mapsto \Delta^{1/2}f=F, \quad \ie \quad F(x)= x^{1/2}f(x) ,
   438	\end{equation}
   439	which respects the convolution product and satisfies the equalities
   440	$$
   441	(\Delta^{1/2}f^\sharp)(x)=x^{1/2}f^\sharp(x)=x^{-1/2}f(x^{-1})=(\Delta^{1/2}f)(x^{-1}).
   442	$$
   443	For a rational place $v$,  denoting
   444	$W_v(F):={\mathcal W}_v(\Delta^{-1/2}F),$  the above distributions $\mathcal W_p$ take the following  form:
   445	\begin{equation}\label{bombieriexplicit1bis}
   446	 W_p(F)=(\log p)\sum_{m=1}^\infty p^{-m/2}\left(F(p^m)+F(p^{-m})\right) ,
   447	 \end{equation}
   448	 while the archimedean distribution $\mathcal W_\R$ becomes
   449	$$
   450	 W_\R(F):=(\log 4\pi +\gamma)F(1)+\int_{1}^\infty\left(F(x)+F(x^{-1})-2x^{-1/2} F(1)\right)\frac{x^{1/2}}{x-x^{-1}}d^*x ,  
   451	 $$  
   452	 where  $ d^*x=dx/x$. The latter can also be expressed as $W_\R = - W_\infty$, where
   453	 \begin{equation}\label{thetaprime}
   454	 W_\infty(F) = \int_\R {\widehat F}(t)\frac{2\partial_t\theta(t)}{2 \pi}dt .
   455	 \end{equation}
   456	 and 
   457	  \begin{equation}\label{riesie}
   458	\theta(t) = - \frac{t}{2} \log \pi + \Im \log \Gamma \left(
   459	\frac{1}{4} + i \frac{t}{2} \right) 
   460	\end{equation}
   461	is  the angular Riemann-Siegel function, with $\log \Gamma(s)$ for $\Re(s)>0$ denoting the 
   462	branch of the logarithm which is real for $s$ real. \newline
   463	
   464	By polarization, the Weil form gives the  sesquilinear expression
   465	\begin{align}\label{bombtest}
   466	QW(f,g)=\Psi(f^**g), \ \  
   467	 \Psi(F):= W_{0,2}(F) - W_\R(F)-\sum_{p} W_p(F). 
   468	 \end{align}
   469	The components $W_\R$ and $W_p$ are as above, and the functional $W_{0,2}$ is  \begin{align}\label{bombtest-0}
   470	 W_{0,2}(F) = {\widehat F}(i/2)+{\widehat F}(-i/2) .
   471	 \end{align}
   472	 
   473	
   474	 
   475	 
   476	There is a rather subtle invariance property of the Weil sesquilinear form, namely
   477	its symmetry under the inversion $\iota(u)=u^{-1}, \, u \in\R^*$, which 
   478	will play a significant role in its explicit description. 
   479	\begin{lem}\label{wsharp} The Weil functional $\Psi$ fulfills 
   480	\begin{equation}\label{weilQexpw}
   481	 \Psi(h)=\Psi^\#(h)+\Psi^\#(h\circ\iota)=\Psi^\#(h+h\circ\iota) ,
   482	\end{equation}
   483	 where $\Psi^\sharp$ is the distribution on $[1,\infty)$,
   484	\begin{align}\label{psipsisharp}
   485	\Psi^\sharp:=W_{0,2}^\# - W_\R^\#-\sum W_p^\#
   486	 \end{align}
   487		with the components given by
   488	\begin{align}\label{bombtest02}
   489	W_{0,2}^\#(F)=\int_{1}^{\infty} F(x)(x^{1/2}+x^{-1/2})d^*x ,\\ \label{bombtestR} 
   490	W_\R^\#(F)=\frac 12(\log 4\pi +\gamma)F(1)+\int_{1}^\infty\frac{x^{1/2}F(x)-F(1)}{x-x^{-1}}d^*x ,
   491	\\ \label{bombtestp}
   492	W_p^\#(F)=(\log p)\sum_{m=1}^\infty p^{-m/2}F(p^m).
   493	 \end{align}
   494	\end{lem}
   495	\proof This follows from the construction of $\Psi$. Note the factor $\frac 12$ in \eqref{bombtestR}. \endproof 
   496	\begin{prop}\label{toadd} Let $\lambda>1$, $L=2\log \lambda$.\newline
   497	$(i)$~The following map is an isometry $\kappa:L^2([0,L],dx)\to L^2([\lambda^{-1}, \lambda],d^*u)$,
   498	\begin{equation}\label{toa}
   499	\kappa(f)(u)=f(\log(\lambda u))
   500	\end{equation}
   501	which induces an isomorphism  $C^\infty([0,L])\to C^\infty([\lambda^{-1}, \lambda])$.\newline
   502		$(ii)$~Let $f,g\in C^\infty([0,L])$. One has 
   503	\begin{equation}\label{weilQexp}
   504	QW(\kappa(f),\kappa(g))=\Psi^\sharp(F), \  \  F(u)=q(f,g)(\log u).
   505	\end{equation}
   620	 Let $E$ be a metric space. If any of the following three properties is satisfied, then all three are satisfied, and $E$ is said to be precompact:\newline
   621	1. For every $\varepsilon>0$, $E$ can be covered by a finite number of balls of radius $\varepsilon$;\newline
   622	2. For every $\varepsilon>0$, $E$ can be covered by a finite number of subsets with diameter less than \(\varepsilon\);\newline
   623	3. Every sequence in  $E$ has a Cauchy subsequence.\newline 
   624	 We shall  show that for any positive increasing function $\rho:[0,\infty)\to [1,\infty)$ such that $\rho(u)\to \infty$ when $u\to \infty$ the embedding $I_\rho$ of the Hilbert space $\cD_\rho$ in $L^2\left(\left[\lambda^{-1}, \lambda\right], d^* u\right)$ is compact, where the norm square in $ \cD_\rho$ is given by 
   625	\begin{equation}\label{mfour}
   626	 \Vert f\Vert_\rho^2:= \int|\hat{f}(t)|^2 \frac{\rho(t)}{2 \pi} d t
   627	 \end{equation}
   628	 In fact one can use the logarithm-exponential isomorphism and replace the Hilbert space $L^2\left(\left[\lambda^{-1}, \lambda\right], d^* u\right)$  by $\cH=L^2\left(\left[-L, L\right], d x\right)$ and use the ordinary Fourier transform in \eqref{mfour}. It is enough to show that the image  $I_\rho(B)$ of the unit ball $B$ of $ \cD_\rho$ is precompact in $\cH$. Let then $\epsilon >0$ and let us show that one can cover $I_\rho(B)$ by finitely many balls of radius $\epsilon$ for the norm of $\cH$. Since $\rho(u)\to \infty$ when $u\to \infty$ there exists $T<\infty$ such that 
   629	\begin{equation}\label{four1}
   630	  \Vert f\Vert_\rho^2\leq 1\Rightarrow \int_{\vert t\vert \geq T}|\hat{f}(t)|^2 \frac{dt}{2 \pi}\leq (\epsilon/4)^2 
   631	\end{equation}
   632	 Next, the operator $\widehat{P_T}P_L$ is a compact operator in $L^2(\R)$ and hence the image $\widehat{P_T}P_L(C)$ of the unit ball $C$ of $L^2(\R)$ is precompact in $L^2(\R)$. By construction $I_\rho(B)\subset \cH=L^2\left(\left[-L, L\right], d x\right)=P_L L^2(\R)$, thus the map 
   633	 $$
   634	 \widehat{P_T}I_\rho:  \cD_\rho\to L^2(\R)
   635	 $$ 
   636	 is compact. 
   637	  Thus there exists a finite set of functions 
   638	$\{f_j\}_{j\in J}\subset B\subset \cD_\rho$,  such that 
   639	$$
   640	\forall f\in B, \exists j \mid \Vert \widehat{P_T} (f-f_j)\Vert^2 \leq (\epsilon/2)^2 .
   641	$$
   642	Thus one has 
   643	$$
   644	\forall f \in B, \exists j \in J \quad \text{such that} \quad
   645	  \int_{\vert t\vert \leq T}|\hat{f}(t)-\hat f_j(t)|^2 \frac{dt}{2 \pi}\leq (\epsilon/2)^2 
   646	$$
   647	By \eqref{four1} it follows that for any $f\in B$ there exists $j$ such that 
   648	\begin{align*}
   649	\Vert f-f_j\Vert^2_\cH&=\int|\hat{f}(t)-\hat f_j(t)|^2 \frac{dt}{2 \pi}=\\
   650	=\int_{\vert t\vert \leq T}|\hat{f}(t)&-\hat f_j(t)|^2 \frac{dt}{2 \pi}+\int_{\vert t\vert \geq T}|\hat{f}(t)-\hat f_j(t)|^2 \frac{dt}{2 \pi}  \leq (\epsilon/2)^2+(\epsilon/2)^2<\epsilon^2 ,
   651	\end{align*}
   652	where we used  \eqref{four1} and the triangle inequality to get 
   653	$$
   654	\left(\int_{\vert t\vert \geq T}|(\hat{f}(t)-\hat f_j)(t)|^2 \frac{dt}{2 \pi}\right)^{1/2}\leq 
   655	\epsilon/4+\epsilon/4=\epsilon/2 .
   656	$$
   657	\endproof 
   658	\begin{cor}\label{lowest} Let $\lambda>1$. There exists an element $\phi\in L^2\left(\left[\lambda^{-1}, \lambda\right], d^* u\right)$ such that $A_\lambda(\phi)=\mu_\lambda\, \phi$ where $\mu_\lambda$ is the largest lower bound of the spectrum of $A_\lambda$.	
   659	\end{cor}
   660	Note that we cannot assert that $\mu_\lambda\geq 0$.  One has however
   661	\begin{equation}\label{monotone}
   662	 \lambda > \lambda' \Rightarrow  \mu_\lambda\leq  \mu_{\lambda'}
   663	\end{equation}
   664	Indeed first note that the test functions which are piecewise smooth form a core for the Weil quadratic form $Q W_\lambda$ since the smooth ones already do by \cite{VJ} and moreover the Fourier transform of piecewise smooth functions $f$ with compact support are  $O(\vert s\vert^{-1})$ since the derivative $f'$ is a bounded measure, so the piecewise smooth functions are in the domain of $Q W_\lambda$. One then uses the equivalence (with $f$ piecewise smooth)
   665	$$
   666	\nu \leq \mu_\lambda\iff Q W_\lambda(f,f) \geq \nu \Vert f\Vert^2, \  \ \forall f \mid \ {\rm support}(f) \subset \left[\lambda^{-1}, \lambda\right]
   667	$$
   668	\begin{cor}\label{strange} If the limit when $\lambda\to \infty$ of the decreasing function $\mu_\lambda$ is equal to $0$  then RH  holds.
   669	\end{cor}
   670	
   671	\section{The matrix of $QW_\lambda$ in the basis $V_n$} 
   672	We now compute the matrix of the sesquilinear form $QW_\lambda(f,g)= \Psi(f^*\ast g)$ in the basis 
   673	$\{V_n\}_{n \in \Z}$. By Proposition \ref{toadd} and the equality $V_n=\kappa(U_n)$ we get  
   674	\begin{equation}\label{weilformbase}
   675	QW_\lambda(V_n,V_m) =
   676	 \Psi^\#(F), \quad \text{where} \quad
   677	 F(x)=q(U_n,U_m)(\log x)
   678	\end{equation}
   679	and $\Psi^\sharp$ was defined in \eqref{psipsisharp}. \newline
   680	Next, we proceed to describe the contribution to the matrix $QW_\lambda(V_n,V_m)$ of each term in \eqref{psipsisharp}. 
   681	
   682	\subsection{The matrix $ W_{0,2}(V_n,V_m)$}
   683	The following lemma  shows that  the terms $ W_{0,2}(V_n,V_m)$ contribute by  a rank two matrix.
   684	\begin{lem}\label{w02} Let $n,m\in \Z$. Let $F(x)=q(U_n,U_m)(\log x)$, then one has :
   685	\begin{equation}\label{hh}
   686	W_{0,2}(V_n,V_m)=W_{0,2}^\#(F)=	\frac{32 L \sinh ^2\left(\frac{L}{4}\right) \left(L^2-16 \pi ^2 m n\right)}{\left(L^2+16 \pi ^2 m^2\right) \left(L^2+16 \pi ^2 n^2\right)}
   687	\end{equation}
   688	\end{lem}
   689	 \proof This is best verified by direct computation. 
   690	 \endproof 
   691	 \subsection{The matrix $ W_p(V_n,V_m)$}
   692	~The contribution of the non archimedean primes is given by \eqref{bombtestp}, \ie 
   693	\begin{equation}\label{bomp}
   694	\sum W_p(V_n,V_m)=\sum_{1<k\leq \exp(L)}\Lambda(k) k^{-1/2}q(U_n,U_m)(\log k).
   695	 \end{equation}
   696	 \subsection{The matrix $ W_\R(V_n,V_m)$}
   697	
   698	 ~Let $\omega(x)=q(U_n,U_m)(x)$, then\eqref{bombtestR} gives
   699	  \begin{align*}
   700	W_\R(V_n,V_m) &=
   701	\int_0^L\frac{\exp \left(\frac{x}{2}\right) \omega(x)- \omega(0)}{\exp \left(x\right)-\exp \left(-x\right)}dx- \omega(0)\int_L^{\infty}\frac{dx}{\exp \left(x\right)-\exp \left(-x\right)}\\ &+\frac{1}{2} (\gamma +\log (4 \pi )) \omega(0).
   702	      \end{align*}
   703	Since
   704	$$
   705	\int_L^{\infty}\frac{dx}{\exp \left(x\right)-\exp \left(-x\right)}=\frac 12 \log\left(\frac{e^L+1}{e^L-1} \right) 
   706	$$
   707	one obtains 
   708	\begin{align}
   709	W_\R(V_n,V_m) &=\frac{ \omega(0)}{2}\left(\gamma +\log \left(4 \pi \frac{e^L-1}{e^L+1}  \right)\right)\nonumber\\ +&\int_0^L\frac{\exp \left(\frac{x}{2}\right) \omega(x)- \omega(0)}{\exp \left(x\right)-\exp \left(-x\right)}dx.\label{weinfty}
   710	\end{align}
   711	The explicit expression for $\omega(x)=q(U_n,U_m)(x)$ for $x\in [0,L]$, is given by Lemma \ref{polarize0}.
   712	The next step is to compute the integrals involved, they are given in terms of known functions in the following proposition \ref{computearch}. We let
   713	$$
   714	\rho(x):=\frac{\exp(x/2)}{\exp(x)-\exp(-x)}
   715	$$
   716	We let $\psi(z)=\Gamma^{\prime}(z) / \Gamma(z)$ be the digamma function and  $\psi ^{(1)}$ be its derivative. We use the standard notation for hypergeometric functions. We use the notation $\Phi$ for the Hurwitz-Lerch function 
   717	$$\Phi (z,2,x)=\frac{1}{x^2}+\frac{z}{(x+1)^2}+\frac{z^2}{(x+2)^2}+\frac{z^3}{(x+3)^2}+\frac{z^4}{(x+4)^2}+\ldots $$
   718	An  important feature of the formulas is that the parameter  $e^{-2L}$ in the various series involved is of modulus $<1$ thus ensuring the convergence and in fact fast numerical convergence for $L$ of order $10$.
   719	\newpage
   720	\begin{prop}\label{computearch} We use the symbols $\Re(z)$ and $\Im(z)$ for the real and imaginary parts of a complex number $z$. One has \begin{align}
   721		&\int_0^L\sin(2 \pi n x/L)\rho(x)dx=\\ & e^{-L/2}\Im(\frac{2L}{L+4 \pi in}\  _2F_1(1, \frac{\pi i n}{ L}+\frac{1}{4}; \frac{\pi i n}{ L}+\frac{5}{4};e^{-2L}))+\frac{1}{2}\Im(\psi(\frac{\pi i n}{ L}+\frac{1}{4})).\nonumber\\
   722		&\int_0^L x\ \cos(2 \pi n x/L)\rho(x)dx=\\ & -Le^{-L/2}\Im\left(\frac{2L}{4 \pi  n-i L}\, _2F_1\left(1,\frac{1}{4}+\frac{i n \pi }{L};\frac{5}{4}+\frac{i n \pi }{L};e^{-2L}\right)\right)\nonumber\\
   723		&-\frac{e^{-L/2}}{4}\Re\left(\Phi \left(e^{-2L},2,\frac{i \pi  n}{L}+\frac{1}{4}\right)\right)+\frac{1}{4}\Re\left(\psi ^{(1)}\left(\frac{\pi i n}{ L}+\frac{1}{4}\right)\right).\nonumber\\
   724		&\int_0^L \ (\cos(2 \pi n x/L)-1)\rho(x)dx=\\ &-e^{-L/2}\Re\left(\frac{2L}{L+4 \pi in}\, _2F_1\left(1,\frac{\pi i n}{ L}+\frac{1}{4};\frac{\pi i n}{ L}+\frac{5}{4};e^{-2L}\right)\right)\nonumber\\ \nonumber
   725		&+2e^{-L/2}\ _2F_1\left(\frac{1}{4},1;\frac{5}{4};e^{-2L}\right)-\frac{1}{2}\Re\left(\psi(\frac{\pi i n}{ L}+\frac{1}{4})-\psi(\frac 14)\right).
   726	\end{align}	
   727	\end{prop}
   728	\proof In each case one first changes variables to $y=2\pi x/L$ and then expand, with $a:=\frac{L}{2\pi}$
   729	$$
   730	\rho(x)=\frac{\exp \left(\frac{a y}{2}\right) }{\exp (a y)-\exp (-a y)}=\sum_{k=0}^\infty \exp(b(k)y), \  \ b(k)=\frac{-a(1+4k) }{2}
   731	$$
   732	The change of variables introduces an overall factor $(\frac{L}{2\pi})^2$ for the middle integral and $(\frac{L}{2\pi})$ for the others. 
   733	  One obtains in this way for each integral a sum of terms indexed by $k\in \N$ and which are
   734	\begin{align}
   735	\int_0^{2 \pi } \exp (b x) \sin (n x) \, dx=&\frac{n-e^{2 \pi  b} n}{b^2+n^2}\\
   736	\int_0^{2 \pi } x \exp (b x) \cos (n x) \, dx=& \frac{2 \pi  e^{2 \pi  b}b-e^{2 \pi  b} +1}{b^2+n^2}-\frac{2 n^2\left(1-e^{2 \pi  b}\right)}{\left(b^2+n^2\right)^2}\\
   737	\int_0^{2 \pi }  \exp (b x)( \cos (n x)-1) \, dx=&\frac{n^2-e^{2 \pi  b} n^2}{b^3+b n^2}	
   738	\end{align}
   739	
   740	\vspace{0.3cm}
   741	All these expressions are affine in $e^{2 \pi  b}$ whose coefficient gives the general term of  a sum over $k\in \N$ using
   742	$$
   743	e^{2 \pi  b(k)}=\exp(-\frac L2(1+4k))=e^{-L/2} z^k, \ \ z=e^{-2L}.
   744	$$ 
   745	One then recognizes the series in $z$ involved and obtains the following expressions \begin{small}
   746	\begin{align*}
   747	&\int_0^L\sin(2 \pi n x/L)\rho(x)dx=\\
   748	& e^{-L/2} \left(\frac{(i L) \, _2F_1\left(1,\frac{1}{4}-\frac{i n \pi }{L};\frac{5}{4}-\frac{i n \pi }{L};e^{-2L}\right)}{L-4 i \pi  n}-\frac{(i L) \, _2F_1\left(1,\frac{i \pi  n}{L}+\frac{1}{4};\frac{i \pi  n}{L}+\frac{5}{4};e^{-2L}\right)}{L+4 i \pi  n}\right)\\
   749	&+\frac{1}{4} i \left(\psi ^{(0)}\left(\frac{1}{4}-\frac{i n \pi }{L}\right)-\psi ^{(0)}\left(\frac{i \pi  n}{L}+\frac{1}{4}\right)\right)
   750	\end{align*}
   751	
   752	\begin{align*}
   753	&\int_0^L x\ \cos(2 \pi n x/L)\rho(x)dx=\\
   754	&e^{-L/2} \left( 
   755	    -\frac{1}{8} \, \Phi\left(e^{-2L}, 2, \frac{i \pi n}{L} + \frac{1}{4}\right)
   756	    -\frac{1}{8} \, \Phi\left(e^{-2L}, 2, \frac{1}{4} - \frac{i \pi n}{L}\right)
   757	\right) \\
   758	& + e^{-L/2} \left(
   759	    \frac{i L^2 \, {}_2F_1\left(1, \frac{i \pi n}{L} + \frac{1}{4}; \frac{i \pi n}{L} + \frac{5}{4}; e^{-2L}\right)}{4 \pi n - i L}
   760	    - \frac{i L^2 \, {}_2F_1\left(1, \frac{1}{4} - \frac{i \pi n}{L}; \frac{5}{4} - \frac{i \pi n}{L}; e^{-2L}\right)}{4 \pi n + i L}
   761	\right) \\
   762	& + \frac{1}{8} \left(
   763	    \psi^{(1)}\left(\frac{i \pi n}{L} + \frac{1}{4}\right) +
   764	    \psi^{(1)}\left(\frac{1}{4} - \frac{i \pi n}{L}\right)
   765	\right)\\
   766	&\int_0^L \ (\cos(2 \pi n x/L)-1)\rho(x)dx=\\
   767	&
   768	 e^{-L/2} \left(-\frac{L \, _2F_1\left(1,\frac{i \pi  n}{L}+\frac{1}{4};\frac{i \pi  n}{L}+\frac{5}{4};e^{-2L}\right)}{L+4 i \pi  n}-\frac{L \, _2F_1\left(1,\frac{1}{4}-\frac{i n \pi }{L};\frac{5}{4}-\frac{i n \pi }{L};e^{-2L}\right)}{L-4 i \pi  n}\right)\\
   769	&+2 e^{-L/2} \, _2F_1\left(\frac{1}{4},1;\frac{5}{4};e^{-2L}\right)+\frac{1}{4} \left(-\psi ^{(0)}\left(\frac{i \pi  n}{L}+\frac{1}{4}\right)-\psi ^{(0)}\left(\frac{1}{4}-\frac{i n \pi }{L}\right)+2 \psi ^{(0)}\left(\frac{1}{4}\right)\right)\end{align*}
   770	\end{small}
   771	Using the real and imaginary parts to simplify these expressions one obtains the required result. \endproof 
   772	For the last integral we have computed a simplified form of the required expression which is 
   773	\begin{equation}\label{corectc}
   774	\int_0^L \ (\cos(2 \pi n x/L)-\exp(-x/2))\rho(x)dx=\int_0^L \ (\cos(2 \pi n x/L)-1)\rho(x)dx+c(L)\end{equation}
   775	where the correction term is 
   776	$$
   777	c(L)=\int_0^L \frac{1-\exp \left(-\frac{x}{2}\right)}{\exp (x)-\exp (-x)} \, dx=$$ $$\log \left(e^{L/2}+1\right)+\frac{1}{4} \left(-2 \log \left(e^L+1\right)-\pi -\log (4)\right)+\tan ^{-1}\left(e^{L/2}\right)
   778	$$
   779	In fact we need to add the following to take into account the full Weil principal value
   780	$$
   781	w(L)=\frac{1}{2} (\gamma +\log (4 \pi ))-\frac{1}{2} \log \left(\frac{e^L+1}{e^L-1}\right)
   782	$$
   783	We then obtain 
   784	$$
   785	c(L)+w(L)=\frac{1}{2} \log \left(\frac{e^{L/2}-1}{e^{L/2}+1}\right)+\tan ^{-1}\left(e^{L/2}\right)-\frac{\pi }{4}+\frac{\gamma }{2}+\frac{1}{2} \log (8 \pi )
   786	$$
   787	To get lighter notations we let
   788	\begin{align}\label{"funct}
   789	&\alpha_L(n):=\frac{1}{\pi}\int_0^L\sin(2 \pi n x/L)\rho(x)dx, \ \\
   790	&    \  \beta_L(n):=\frac 1L\int_0^L x\ \cos(2 \pi n x/L)\rho(x)dx, \  \\
   791	& \gamma_L(n):=\int_0^L \ (\cos(2 \pi n x/L)-\exp(-x/2))\rho(x)dx+c(L)+w(L)
   792	\end{align}
   793	Using these notations, Proposition \ref{computearch} and \eqref{weinfty}, one obtains 
   794	\begin{prop}\label{bigmatrix} The matrix $ W_\R(V_n,V_m)$ is given by the following table
   795	 $$
   796	 \begin{array}{ccc}
   797	 	m\neq n &\vline & \frac{\alpha_L(m)-\alpha_L(n)}{n-m}\\
   798	 	m= n &\vline & 2\gamma_L(n)-2\beta_L(n)
   799	 \end{array}
   800	$$
   801	 \end{prop}
   802	 \proof Follows from Lemma \ref{polarize0}.\endproof
   803	 
